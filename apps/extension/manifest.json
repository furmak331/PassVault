{
  "manifest_version": 3,
  "name": "PassVaultify",
  "short_name": "PassVaultify",
  "description": "A zero-knowledge password manager. Fills logins only on the site they belong to.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "action": {
    "default_popup": "popup.html",
    "default_title": "PassVaultify",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "setup.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "scripting", "storage", "alarms", "idle"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Open PassVaultify"
    },
    "fill-login": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" },
      "description": "Fill the login for this site"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
