# Copy to .env and fill in.

# The name that points at this machine. Caddy gets its HTTPS certificate.
DOMAIN=vault.example.com

# open: anyone who can reach the server can create an account.
# closed: no new accounts. Create yours, then switch to closed.
PASSVAULTIFY_REGISTRATION=open

# Only with compose.postgres.yml.
POSTGRES_PASSWORD=change-me-to-something-long
