# Copy to .env and fill in. Never commit .env.

# A one-time auth key from https://login.tailscale.com/admin/settings/keys
# (Generate auth key: not reusable, not ephemeral). Only needed for the first
# start; after that the machine stays signed in, and you can delete this line.
TS_AUTHKEY=tskey-auth-replace-me

# The machine's name on your tailnet: the server will be at
# https://<TS_HOSTNAME>.<your-tailnet>.ts.net
TS_HOSTNAME=vault

# open: anyone on your tailnet can create an account.
# closed: no new accounts. Create yours, then switch to closed.
PASSVAULTIFY_REGISTRATION=open

# Where daily backups go. A folder synced to OneDrive or Google Drive is a good
# choice: the backups are encrypted like the vault. On Windows, use forward
# slashes, e.g. C:/Users/you/OneDrive/PassVaultify-backups
BACKUP_DIR=./backups
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24
