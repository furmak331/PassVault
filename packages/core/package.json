{
  "name": "@passvaultify/core",
  "version": "0.1.0",
  "private": true,
  "description": "Crypto, vault model and shared logic for every PassVaultify client.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api:types": "openapi-typescript ../../spec/openapi.yaml -o src/sync/openapi.ts && prettier --write src/sync/openapi.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1"
  }
}
